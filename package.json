{
  "name": "diagnostic-profile",
  "version": "0.2.0",
  "description": "Create distinctive GitHub READMEs with visual worlds, a browser Studio, static SVG kits and a versioned GitHub Action.",
  "type": "module",
  "license": "MIT",
  "author": "Yago Borba",
  "private": true,
  "bin": {
    "diagnostic-profile": "src/cli.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node src/cli.mjs",
    "preview": "node scripts/preview.mjs",
    "studio": "node scripts/studio.mjs --serve",
    "build:studio": "node scripts/studio.mjs",
    "proof": "node scripts/visual-proof.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test \"test/*.test.mjs\""
  },
  "keywords": [
    "github-profile",
    "readme",
    "svg",
    "github-actions",
    "profile-readme"
  ],
  "devDependencies": {
    "ajv": "^8.20.0",
    "fflate": "^0.8.3",
    "saxes": "^6.0.0",
    "yaml": "^2.9.1"
  }
}
